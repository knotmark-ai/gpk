{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/entry.mjs\" SessionStart",
        "timeout": 5
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/entry.mjs\" UserPromptSubmit",
        "timeout": 5
      }]
    }]
  }
}
